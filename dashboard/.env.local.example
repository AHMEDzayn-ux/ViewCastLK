# Public base URL for the Prediction API backend.
# Example: http://127.0.0.1:8000
NEXT_PUBLIC_PREDICTION_API_URL=http://127.0.0.1:8000

# Set false for real Prediction API mode (both /forecast and /channel-lookup).
# Set true for isolated development mock mode.
NEXT_PUBLIC_USE_MOCK_API=false

# Never add Supabase service-role/secret keys, database connection strings,
# YouTube, Gemini, model, or other private API credentials here.
# NEXT_PUBLIC_ values are bundled into browser JavaScript at build time.

# Public Supabase Auth browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Cloudflare Turnstile widget site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
