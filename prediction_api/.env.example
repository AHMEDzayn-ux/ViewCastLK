YOUTUBE_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DASHBOARD_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional semicolon-separated models tried after GEMINI_MODEL.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite;gemini-3.7-flash;gemini-3.6-flash;gemini-3.5-flash;gemini-3-flash-preview;gemini-2.5-flash;gemini-2.5-flash-lite

# Server-only creator connection settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_AUTH_DB_URL=
# Optional future public-roster integration. Leave empty for the standalone
# creator-personalization deployment.
SUPABASE_WAREHOUSE_DB_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
# URL-safe base64 encoding of exactly 32 random bytes (AES-256-GCM key).
TOKEN_ENCRYPTION_KEY=
CREATOR_HISTORY_VIDEO_LIMIT=200
# Keep at 10 unless Analytics response completeness is separately verified.
YOUTUBE_ANALYTICS_BATCH_SIZE=10
